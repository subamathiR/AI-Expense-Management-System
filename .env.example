# ===================================================================
# EXPENSEAI — CONFIGURATION & ENVIRONMENT VARIABLES
# ===================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/expenseai

JWT_SECRET=your_jwt_secret_here

# Optional: Google Cloud Vision API Key (falls back to local Tesseract OCR if empty)
GOOGLE_VISION_API_KEY=

# Optional: Exchange Rate API Key (defaults to embedded resilient baseline converter)
EXCHANGE_RATE_API_KEY=

# Optional: LLM Configuration for Extended AI Insights (e.g. OpenAI / Gemini)
AI_API_KEY=
